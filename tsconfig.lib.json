// Emits the library's type declarations into dist/ (see `npm run build:types`)
{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["src/entry-lib.ts", "src/lib/**/*"],
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo"
  }
}
