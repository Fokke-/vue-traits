{
  "name": "vue-traits",
  "version": "1.0.0",
  "description": "Typed, reusable props (traits) for Vue components that map to classes, styles and attributes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fokke-/vue-traits.git"
  },
  "keywords": [
    "vue",
    "vue3",
    "design-system",
    "props",
    "styles",
    "css-variables"
  ],
  "license": "MIT",
  "author": {
    "name": "Ville Fokke Saarivaara",
    "email": "ville.saarivaara@gmail.com",
    "url": "https://fokke.fi"
  },
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "module": "./dist/vue-traits.js",
  "types": "./dist/entry-lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/entry-lib.d.ts",
      "import": "./dist/vue-traits.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "format": "prettier --write ./",
    "format:check": "prettier --check ./",
    "type-check": "vue-tsc --build",
    "test": "vitest",
    "test:run": "vitest run",
    "build": "run-s type-check build:lib build:types",
    "build:lib": "vite build --mode lib",
    "build:types": "tsc -p tsconfig.lib.json",
    "prepublishOnly": "run-s test:run build"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,vue,html,css,json,md,yaml,yml}": "prettier --write"
  },
  "peerDependencies": {
    "vue": "^3.5.29"
  },
  "devDependencies": {
    "@tsconfig/node24": "24.0.5",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "happy-dom": "21.0.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "npm-run-all2": "9.0.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vite-plugin-vue-devtools": "8.2.1",
    "vitest": "5.0.4",
    "vue": "3.5.43",
    "vue-tsc": "3.3.13"
  }
}
