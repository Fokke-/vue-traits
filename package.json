{
  "name": "vue-traits",
  "version": "0.1.0",
  "description": "Reusable, typed style props (traits) for Vue components",
  "keywords": [
    "vue",
    "vue3",
    "design-system",
    "props",
    "styles",
    "css-variables"
  ],
  "license": "MIT",
  "author": "Ville Fokke Saarivaara",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "module": "./dist/vue-traits.js",
  "types": "./dist/entry-lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/entry-lib.d.ts",
      "import": "./dist/vue-traits.js"
    }
  },
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "format": "prettier --write ./",
    "type-check": "vue-tsc --build",
    "build": "run-s type-check build:lib build:types",
    "build:lib": "vite build --mode lib",
    "build:types": "tsc -p tsconfig.lib.json",
    "prepublishOnly": "npm run build"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,vue,html,css,json,md,yaml,yml}": "prettier --write"
  },
  "peerDependencies": {
    "vue": "^3.5.29"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "3.9.10",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
